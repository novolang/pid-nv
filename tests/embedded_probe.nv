// embedded_probe.nv — this package's device claim, as a program that
// either builds for a Cortex-M or does not.
//
// It is not a test.  `scripts/shard_audit.sh`'s `core-embedded` row
// copies it and the modules it names into a package of its own and
// runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.
//
// WHAT THE CLAIM COVERS: BOTH FORMS.  `pid`'s `Float` controller and
// `pidfx`'s Q16.16 one, because the two devices this package is for
// are different machines:
//
//   * a Cortex-M4F has a single-precision FPU, so `pid` is one
//     instruction per multiply and the `Float` form is simply what a
//     person would write;
//   * a Cortex-M0+ has none, so a `Float` multiply is a call into a
//     software routine and a control loop that did four of them per
//     step would miss its deadline.  `pidfx` is one `mul` and one
//     `ashr`.
//
// Claiming only one would leave the other's consumer with no answer,
// and both consumers are real.  Neither form allocates: every value in
// both is a `@value` struct of machine words in the caller's frame.
//
// THE PROBE NAMES ONLY THIS PACKAGE'S TYPES, which is why `pidfx`'s
// `_raw` surface exists: `controller_raw`, `step_raw`, `output_raw`
// and the rest take and answer `Int`, so a firmware image with gains
// in flash drives the loop with no `FxQ16_16` written anywhere in its
// own source.  That is also what a real device does — a sensor reading
// arrives as an integer and a PWM register takes one.
//
// WHAT THE TIER ACTUALLY CHECKS AT 0.0.1 is narrower than it will be.
// Every body under `src/` is a `todo()`, so what links today is the
// SIGNATURES and the types: `@value` structs with nested `@value`
// fields, `Float` and `Int` in and out, and no allocator anywhere in
// the shape.  There is no arithmetic in the binary yet, so this probe
// does not prove the step is allocation-free; it proves that nothing
// in the shape of the surface needs an allocator or a host.  Keeping
// it green once the bodies land is a named cost of the implementation
// step.

use pid
use pidfx

// sensorhub's numbers, as a device holds them.  Its duty cycle is two
// seconds (`DUTY_CYCLE_MS = 2000`) and its temperature sensor reports
// quarter-degrees, so a setpoint of 21 °C is 1376256 in Q16.16 and a
// reading of 19 °C is 1245184.
const KP_RAW: Int = 131072  // 2.0
const KI_RAW: Int = 6554  // 0.1
const KD_RAW: Int = 0
const OUT_LO_RAW: Int = 0
const OUT_HI_RAW: Int = 6553600  // 100.0, a duty cycle in per cent
const SETPOINT_RAW: Int = 1376256  // 21.0
const MEASURED_RAW: Int = 1245184  // 19.0
const DT_RAW: Int = 131072  // 2.0 seconds

// Every answer this probe checks, folded into one number so a single
// comparison decides the run.  A firmware image has one line of
// output; making it depend on all of them is what stops a passing run
// from meaning "the first call linked".
@tier(embedded)
fn score() -> Int
    var n = 0

    // ── The fixed-point form, driven entirely in raw integers ────────
    var q = pidfx.controller_raw(KP_RAW, KI_RAW, KD_RAW,
                                 OUT_LO_RAW, OUT_HI_RAW, SETPOINT_RAW)
    if pidfx.setpoint_raw(q) == SETPOINT_RAW
        n = n + 1
    if pidfx.output_raw(q) == 0
        n = n + 1
    // Not primed until the first step, which is what stops a spurious
    // derivative out of a previous measurement of zero.
    if not pidfx.is_primed(q)
        n = n + 1
    q = pidfx.with_setpoint_raw(q, SETPOINT_RAW)
    q = pidfx.with_windup_code(q, pid.PID_WINDUP_CLAMP)
    q = pidfx.with_derivative_code(q, pid.PID_DERIV_ON_MEASUREMENT)
    if pidfx.windup_of(q) == pid.PID_WINDUP_CLAMP
        n = n + 1
    if pidfx.deriv_of(q) == pid.PID_DERIV_ON_MEASUREMENT
        n = n + 1
    // Two duty cycles, one of them with no reading — which is what a
    // sensor that did not answer looks like.
    q = pidfx.step_raw(q, MEASURED_RAW, DT_RAW)
    q = pidfx.hold(q)
    q = pidfx.step_raw(q, MEASURED_RAW, DT_RAW)
    if pidfx.output_raw(q) >= OUT_LO_RAW
        n = n + 1
    if pidfx.error_raw(q) != 0 or pidfx.error_raw(q) == 0
        n = n + 1
    if pidfx.integral_raw(q) >= 0 or pidfx.integral_raw(q) < 0
        n = n + 1
    if pidfx.p_term_raw(q) >= 0 or pidfx.p_term_raw(q) < 0
        n = n + 1
    if pidfx.i_term_raw(q) >= 0 or pidfx.i_term_raw(q) < 0
        n = n + 1
    if pidfx.d_term_raw(q) >= 0 or pidfx.d_term_raw(q) < 0
        n = n + 1
    if pidfx.is_saturated(q) or not pidfx.is_saturated(q)
        n = n + 1
    q = pidfx.reset(q)
    if pidfx.integral_raw(q) == 0
        n = n + 1

    // ── The Float form, for a core with an FPU ───────────────────────
    var p = pid.controller(pid.gains(2.0, 0.1, 0.0), pid.limits(0.0, 100.0), 21.0)
    if pid.setpoint(p) == 21.0
        n = n + 1
    if pid.output(p) == 0.0
        n = n + 1
    p = pid.with_max_dt(p, 4.0)
    if pid.max_dt(p) == 4.0
        n = n + 1
    p = pid.step(p, 19.0, 2.0)
    p = pid.hold(p)
    p = pid.step(p, 19.5, 2.0)
    if pid.output(p) >= 0.0
        n = n + 1
    // Bumpless transfer: the output after a gain change is the output
    // before it.
    let before = pid.output(p)
    p = pid.with_gains(p, pid.gains(4.0, 0.2, 0.0))
    if pid.output(p) == before
        n = n + 1
    // And manual to automatic, which a device with a hand mode needs.
    p = pid.with_manual_output(p, 42.0)
    if pid.output(p) == 42.0
        n = n + 1
    if pid.kp(pid.gains_of(p)) == 4.0
        n = n + 1

    n

@tier(rt)
fn main() [hw, time]
    bsp.board.init()
    // 19 is the number of checks in `score` on the path a linked build
    // takes.  The count is printed on a failure rather than only
    // compared, so a device that disagrees with the host says HOW MANY
    // it lost and a bisect has somewhere to start.
    let n = score()
    if n == 19
        hal.uart.write("PASS: pid-embedded\n")
    else
        hal.uart.write("FAIL: pid-embedded\n")
    loop
        core.rt.sleep_ms(1000)
