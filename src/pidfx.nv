// pidfx.nv — the same controller in Q16.16, for a core with no FPU.
//
// WHY A SECOND FORM RATHER THAN A GENERIC ONE.  A type cannot carry a
// numeric parameter here and there is no trait a `@value` arithmetic
// type can implement that a `@value` struct can be generic over, so
// one controller over "a number" is not expressible.  Written out by
// hand is the honest alternative, and it is the same choice
// fixedpoint-nv itself made for its four Q formats and for the same
// reason.
//
// THE TWO FORMS ARE THE SAME SURFACE, function for function, with
// `Float` replaced by `FxQ16_16` and `pid` replaced by `pidfx`.  That
// is deliberate and it is checkable: a caller porting a loop from a
// Linux service to a Cortex-M0 changes the module name and the number
// type and nothing else, and a reviewer comparing the two files sees
// only those two substitutions.
//
// WHAT Q16.16 COSTS AND BUYS.  The range is -32768 to 32767.99998 and
// the step is 2^-16, about 0.0000153, CONSTANT across the whole range —
// which is the difference from a float, whose step near 1000 is a
// thousand times its step near 1.  For a control loop that matters in
// one specific way: a convergence test against `epsilon` means the
// same thing at every operating point, so a loop that settles at a
// setpoint of 20 settles the same way at a setpoint of 2000.
//
// What it costs is that the gains have to FIT.  `kp` of 40000 is not
// representable, and a plant that wants one wants its measurement
// rescaled rather than a wider type.  `check` reports a gain that
// saturated.
//
// SATURATING ARITHMETIC THROUGHOUT.  fixedpoint-nv offers three
// families — trapping, saturating and wrapping — and this package uses
// the `sat_` one everywhere.  A control loop that TRAPPED would take
// the firmware down on a transient; one that WRAPPED would drive an
// actuator to its opposite extreme, which is worse than either.
// Saturating is the only one of the three whose failure mode is
// "the output sat at its limit", which is a thing an operator can see.
//
// THE DEVICE THIS IS FOR is in `tests/embedded_probe.nv` and in the
// README: sensorhub, which reads an nRF52 on-die temperature in units
// of a quarter degree every two seconds and has nothing to close a
// loop with.

use fxq16_16
use pid
use piderr

// ── Gains and limits ─────────────────────────────────────────────────

// The three gains, in Q16.16.
//
// PARALLEL FORM, the same as `pid.PidGains` — the output is
// `kp*e + ki*∫e + kd*de/dt` — so a gain set converts between the two
// forms by `fxq16_16.from_float` and nothing else.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let g = pidfx.gains(fxq16_16.from_int(2), fxq16_16.zero(), fxq16_16.zero())
//     println("${fxq16_16.raw(pidfx.kp(g))}")      // 131072
// ```
pub @value
struct PidFxGains
    // Proportional gain.
    kp: FxQ16_16
    // Integral gain, per second.
    ki: FxQ16_16
    // Derivative gain, per second.
    kd: FxQ16_16

// What the output is allowed to be, in Q16.16.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let l = pidfx.limits(fxq16_16.zero(), fxq16_16.from_int(100))
//     println("${fxq16_16.raw(pidfx.limit_high(l))}")
// ```
pub @value
struct PidFxLimits
    // The lowest output the actuator accepts.
    lo: FxQ16_16
    // The highest.
    hi: FxQ16_16

// The three gains.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let g = pidfx.gains(fxq16_16.one(), fxq16_16.zero(), fxq16_16.zero())
//     println("${fxq16_16.raw(pidfx.kp(g))}")      // 65536
// ```
pub fn gains(kp: FxQ16_16, ki: FxQ16_16, kd: FxQ16_16) -> PidFxGains []
    PidFxGains { kp: kp, ki: ki, kd: kd }

// The proportional gain.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.kp(pidfx.gains(fxq16_16.one(), fxq16_16.zero(), fxq16_16.zero())))}")
// ```
pub fn kp(g: PidFxGains) -> FxQ16_16 []
    g.kp

// The integral gain.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.ki(pidfx.gains(fxq16_16.zero(), fxq16_16.one(), fxq16_16.zero())))}")
// ```
pub fn ki(g: PidFxGains) -> FxQ16_16 []
    g.ki

// The derivative gain.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.kd(pidfx.gains(fxq16_16.zero(), fxq16_16.zero(), fxq16_16.one())))}")
// ```
pub fn kd(g: PidFxGains) -> FxQ16_16 []
    g.kd

// The output range.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.limit_low(pidfx.limits(fxq16_16.zero(), fxq16_16.one())))}")
// ```
pub fn limits(lo: FxQ16_16, hi: FxQ16_16) -> PidFxLimits []
    PidFxLimits { lo: lo, hi: hi }

// The low limit.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.limit_low(pidfx.limits(fxq16_16.zero(), fxq16_16.one())))}")
// ```
pub fn limit_low(l: PidFxLimits) -> FxQ16_16 []
    l.lo

// The high limit.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.limit_high(pidfx.limits(fxq16_16.zero(), fxq16_16.one())))}")
// ```
pub fn limit_high(l: PidFxLimits) -> FxQ16_16 []
    l.hi

// ── The controller ───────────────────────────────────────────────────

// A PID controller in flight, in Q16.16.
//
// `pid.PidF`'s eighteen fields with `Float` replaced by `FxQ16_16`,
// which is a 32-bit integer in a `@value` — so the state is about
// eighty bytes in the caller's frame and a device holding three of
// them holds them in `.bss`.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.controller(
//                 pidfx.gains(fxq16_16.from_int(2), fxq16_16.zero(), fxq16_16.zero()),
//                 pidfx.limits(fxq16_16.zero(), fxq16_16.from_int(100)),
//                 fxq16_16.from_int(21))
//     println("${fxq16_16.raw(pidfx.output(p))}")  // 0
// ```
pub @value
struct PidFx
    // The three gains.
    gains: PidFxGains
    // What the output may be.
    limits: PidFxLimits
    // What the measurement is being driven towards.
    setpoint: FxQ16_16
    // The accumulated integral of the error, in error-units × seconds,
    // BEFORE `ki` is applied.
    integral: FxQ16_16
    // The measurement the previous step saw.
    prev_measurement: FxQ16_16
    // The error the previous step saw.
    prev_error: FxQ16_16
    // The filtered derivative carried between steps.
    d_state: FxQ16_16
    // The derivative low-pass time constant, in seconds.
    tau: FxQ16_16
    // The back-calculation gain.
    kt: FxQ16_16
    // The largest `dt` a single step will act on, in seconds.
    dt_max: FxQ16_16
    // The output the last `step` produced, within the limits.
    output: FxQ16_16
    // The proportional term of the last output.
    p_term: FxQ16_16
    // The integral term of the last output.
    i_term: FxQ16_16
    // The derivative term of the last output.
    d_term: FxQ16_16
    // The anti-windup policy, as `pid.PID_WINDUP_*`.
    windup: Int
    // The derivative source, as `pid.PID_DERIV_*`.
    deriv: Int
    // Whether the previous sample is real.
    primed: Bool
    // Whether the last output hit a limit.
    saturated: Bool

// A controller with the given gains, limits and setpoint.
//
// The same defaults as `pid.controller`: clamping anti-windup,
// derivative on measurement, no filter, a zero back-calculation gain,
// a `dt` ceiling of one second, a zero integral, and not primed.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.controller(
//                 pidfx.gains(fxq16_16.from_int(2), fxq16_16.zero(), fxq16_16.zero()),
//                 pidfx.limits(fxq16_16.zero(), fxq16_16.from_int(100)),
//                 fxq16_16.from_int(21))
//     println("${fxq16_16.raw(pidfx.setpoint(p))}")
// ```
pub fn controller(g: PidFxGains, l: PidFxLimits, setpoint: FxQ16_16) -> PidFx []
    PidFx { gains: g, limits: l, setpoint: setpoint, integral: fxq16_16.zero(),
            prev_measurement: fxq16_16.zero(), prev_error: fxq16_16.zero(),
            d_state: fxq16_16.zero(), tau: fxq16_16.zero(), kt: fxq16_16.zero(),
            dt_max: fxq16_16.one(), output: fxq16_16.zero(),
            p_term: fxq16_16.zero(), i_term: fxq16_16.zero(),
            d_term: fxq16_16.zero(), windup: pid.PID_WINDUP_CLAMP,
            deriv: pid.PID_DERIV_ON_MEASUREMENT, primed: false, saturated: false }

// A controller built entirely from RAW Q16.16 integers.
//
// THE DEVICE CONSTRUCTOR.  A firmware image holds its gains as words
// in flash — a provisioning step wrote `131072` for a `kp` of 2 — and
// this is the call that takes them without a float anywhere in the
// program and without the caller naming fixedpoint-nv's type.  It is
// also what `tests/embedded_probe.nv` uses, because a probe may name
// only this package's own types.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)
//     println("${fxq16_16.raw(pidfx.setpoint(p))}")   // 1376256
// ```
pub fn controller_raw(kp_raw: Int, ki_raw: Int, kd_raw: Int, lo_raw: Int, hi_raw: Int,
                      setpoint_raw: Int) -> PidFx []
    controller(gains(fxq16_16.from_raw(kp_raw), fxq16_16.from_raw(ki_raw),
                     fxq16_16.from_raw(kd_raw)),
               limits(fxq16_16.from_raw(lo_raw), fxq16_16.from_raw(hi_raw)),
               fxq16_16.from_raw(setpoint_raw))

// ── One step ─────────────────────────────────────────────────────────

// `x` brought inside `l`, in this form's comparison.  The one place this
// module's clamp is written down.
fn clamp_output(x: FxQ16_16, l: PidFxLimits) -> FxQ16_16
    if fxq16_16.compare(x, l.lo) < 0
        return l.lo
    if fxq16_16.compare(x, l.hi) > 0
        return l.hi
    x

// `a / b`, saturating, for a divisor of any size.
//
// NOT `fxq16_16.sat_div`: that one guards the divisor rather than the
// quotient and answers `max_value` whenever the divisor's raw word is
// below 65536 — which is every `dt` a control loop actually uses, a
// 10 ms sample being 655.  `from_ratio` divides the two raw words and
// clamps the quotient, which is the same no-trap policy applied where
// the overflow can actually happen.  `fxq16_16.div` would be right and
// traps; the fixed-point form saturates everywhere.
fn divide(a: FxQ16_16, b: FxQ16_16) -> FxQ16_16
    fxq16_16.from_ratio(fxq16_16.raw(a), fxq16_16.raw(b))

// Advance the controller by `dt` seconds with a new `measurement`.
//
// `pid.step`'s six steps, in saturating Q16.16 arithmetic.  Every rule
// it states holds here: a non-positive `dt` holds, a `dt` above
// `dt_max` is clamped, the derivative is skipped on the first step
// after construction or `reset` or `hold`, and the integral is updated
// after the output clamp.
//
// One rule is this form's alone: EVERY OPERATION SATURATES.  A gain
// and an error whose product exceeds Q16.16's range give the largest
// representable number rather than a trap or a wrap, and the output is
// clamped to the limits immediately afterwards — so the visible effect
// is an actuator at its limit, which is a thing an operator sees and
// can act on.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     var p = pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)
//     p = pidfx.step(p, fxq16_16.from_int(19), fxq16_16.from_float(0.1))
//     println("${fxq16_16.raw(pidfx.output(p))}")
// ```
pub fn step(p: PidFx, measurement: FxQ16_16, dt: FxQ16_16) -> PidFx []
    if fxq16_16.compare(dt, fxq16_16.zero()) <= 0
        return hold(p)
    var elapsed = dt
    if fxq16_16.compare(elapsed, p.dt_max) > 0
        elapsed = p.dt_max
    // An unrecognized policy code resolves to clamping, as it does in
    // the `Float` form: a code nobody meant must not switch anti-windup
    // off.
    let policy = windup_of(p)
    let err = fxq16_16.sat_sub(p.setpoint, measurement)
    let pe = fxq16_16.sat_mul(p.gains.kp, err)
    var ds = fxq16_16.zero()
    if p.primed
        // `-(m - m_prev) / dt`, written as `(m_prev - m) / dt` so that
        // negating the minimum value cannot be reached at all.
        var raw = divide(fxq16_16.sat_sub(p.prev_measurement, measurement), elapsed)
        if p.deriv == pid.PID_DERIV_ON_ERROR
            raw = divide(fxq16_16.sat_sub(err, p.prev_error), elapsed)
        if fxq16_16.compare(p.tau, fxq16_16.zero()) > 0
            let alpha = divide(p.tau, fxq16_16.sat_add(p.tau, elapsed))
            ds = fxq16_16.sat_add(fxq16_16.sat_mul(alpha, p.d_state),
                                  fxq16_16.sat_mul(fxq16_16.sat_sub(fxq16_16.one(), alpha), raw))
        else
            ds = raw
    let de = fxq16_16.sat_mul(p.gains.kd, ds)
    let gained = fxq16_16.sat_add(p.integral, fxq16_16.sat_mul(err, elapsed))
    let probe = fxq16_16.sat_add(fxq16_16.sat_add(pe, fxq16_16.sat_mul(p.gains.ki, gained)), de)
    let probe_out = clamp_output(probe, p.limits)
    // Clamping policy: a step whose error drives FURTHER into a limit
    // that the probe has already reached leaves the integral where it
    // was.  An error with the opposite sign unwinds.
    var frozen = false
    if policy == pid.PID_WINDUP_CLAMP and fxq16_16.compare(probe_out, probe) != 0
        if fxq16_16.compare(err, fxq16_16.zero()) > 0
            and fxq16_16.compare(probe_out, p.limits.hi) == 0
            frozen = true
        if fxq16_16.compare(err, fxq16_16.zero()) < 0
            and fxq16_16.compare(probe_out, p.limits.lo) == 0
            frozen = true
    var acc = gained
    if frozen
        acc = p.integral
    var it = fxq16_16.sat_mul(p.gains.ki, acc)
    var unsat = fxq16_16.sat_add(fxq16_16.sat_add(pe, it), de)
    var out = clamp_output(unsat, p.limits)
    // Back-calculation: the integral takes the step the clamped output
    // implies instead of the one the error implies, so the two agree
    // again by the next sample.  Recomputed from `p.integral`, not from
    // `acc` — the clamp branch above must not be able to skip this one,
    // and both policies can be selected on the same controller over
    // time.
    if policy == pid.PID_WINDUP_BACK_CALCULATION
        let deficit = fxq16_16.sat_sub(probe_out, probe)
        acc = fxq16_16.sat_add(p.integral,
                               fxq16_16.sat_mul(
                                   fxq16_16.sat_add(err, fxq16_16.sat_mul(p.kt, deficit)),
                                   elapsed))
        it = fxq16_16.sat_mul(p.gains.ki, acc)
        unsat = fxq16_16.sat_add(fxq16_16.sat_add(pe, it), de)
        out = clamp_output(unsat, p.limits)
    let sat = fxq16_16.compare(out, unsat) != 0
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: acc,
            prev_measurement: measurement, prev_error: err, d_state: ds,
            tau: p.tau, kt: p.kt, dt_max: p.dt_max, output: out, p_term: pe,
            i_term: it, d_term: de, windup: p.windup, deriv: p.deriv,
            primed: true, saturated: sat }

// Advance the controller with a raw Q16.16 measurement and a raw
// `dt`.
//
// The device path, and what the probe calls: a sensor reading arrives
// as an integer and there is no reason to build a type around it in
// firmware that has no float.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     var p = pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)
//     p = pidfx.step_raw(p, 1245184, 131072)
//     println("${pidfx.output_raw(p)}")
// ```
pub fn step_raw(p: PidFx, measurement_raw: Int, dt_raw: Int) -> PidFx []
    step(p, fxq16_16.from_raw(measurement_raw), fxq16_16.from_raw(dt_raw))

// Skip a step: the output stays and the derivative is un-primed.
//
// `pid.hold`, and it exists for the same reason — a duty-cycle sensor
// that sometimes returns nothing must not be stepped with a stale
// reading.  sensorhub's temperature peripheral answers `NO_READING` on
// a board with no TEMP unit, and this is what a loop over it calls.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     let p = pidfx.hold(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))
//     println("${pidfx.is_primed(p)}")             // false
// ```
pub fn hold(p: PidFx) -> PidFx []
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: false, saturated: p.saturated }

// Clear the integral, the derivative state and the output.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     let p = pidfx.reset(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))
//     println("${pidfx.integral_raw(p)}")          // 0
// ```
pub fn reset(p: PidFx) -> PidFx []
    // The configuration stays: gains, limits, setpoint, filter, gain,
    // ceiling and the two policies are what the caller asked for, and
    // clearing them would make this `controller` with extra steps.
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint,
            integral: fxq16_16.zero(), prev_measurement: fxq16_16.zero(),
            prev_error: fxq16_16.zero(), d_state: fxq16_16.zero(), tau: p.tau,
            kt: p.kt, dt_max: p.dt_max, output: fxq16_16.zero(),
            p_term: fxq16_16.zero(), i_term: fxq16_16.zero(),
            d_term: fxq16_16.zero(), windup: p.windup, deriv: p.deriv,
            primed: false, saturated: false }

// ── Bumpless transfer ────────────────────────────────────────────────

// The controller with new gains, and the integral rewritten so the
// output does not jump.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     var p = pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)
//     p = pidfx.with_gains(p, pidfx.gains(fxq16_16.from_int(4), fxq16_16.zero(), fxq16_16.zero()))
//     println("${pidfx.output_raw(p)}")            // 0
// ```
pub fn with_gains(p: PidFx, g: PidFxGains) -> PidFx []
    // The new `ki` divided back out of the old term is the integral
    // that produces the same contribution, so `p_term + i_term +
    // d_term` — and therefore the output — is where the old gains left
    // it.  Nothing else moves, `output` included: this is not a step.
    var acc = fxq16_16.zero()
    if fxq16_16.compare(g.ki, fxq16_16.zero()) != 0
        acc = divide(p.i_term, g.ki)
    PidFx { gains: g, limits: p.limits, setpoint: p.setpoint, integral: acc,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: fxq16_16.sat_mul(g.ki, acc),
            d_term: p.d_term, windup: p.windup, deriv: p.deriv,
            primed: p.primed, saturated: p.saturated }

// The controller made to agree with an output somebody else chose.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_manual_output(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                      fxq16_16.from_int(42))
//     println("${pidfx.output_raw(p)}")            // 2752512
// ```
pub fn with_manual_output(p: PidFx, u: FxQ16_16) -> PidFx []
    let u_clamped = clamp_output(u, p.limits)
    // The two gain terms are history's, not this instant's: the caller
    // is choosing an output, and the integral is the only place left to
    // put the difference.
    let it = fxq16_16.sat_sub(fxq16_16.sat_sub(u_clamped, p.p_term), p.d_term)
    var acc = fxq16_16.zero()
    if fxq16_16.compare(p.gains.ki, fxq16_16.zero()) != 0
        acc = divide(it, p.gains.ki)
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: acc,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: u_clamped, p_term: p.p_term, i_term: it, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: fxq16_16.compare(u_clamped, u) != 0 }

// ── Configuration ────────────────────────────────────────────────────

// The controller with a new setpoint.  The integral is not touched.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_setpoint(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                 fxq16_16.from_int(23))
//     println("${pidfx.setpoint_raw(p)}")          // 1507328
// ```
pub fn with_setpoint(p: PidFx, setpoint: FxQ16_16) -> PidFx []
    PidFx { gains: p.gains, limits: p.limits, setpoint: setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: p.saturated }

// The controller with a new setpoint, as a raw Q16.16 integer.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_setpoint_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256), 1507328)
//     println("${pidfx.setpoint_raw(p)}")          // 1507328
// ```
pub fn with_setpoint_raw(p: PidFx, setpoint_raw: Int) -> PidFx []
    with_setpoint(p, fxq16_16.from_raw(setpoint_raw))

// The controller with new output limits.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let l = pidfx.limits(fxq16_16.zero(), fxq16_16.from_int(50))
//     println("${fxq16_16.raw(pidfx.limit_high(pidfx.limits_of(pidfx.with_limits(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256), l))))}")
// ```
pub fn with_limits(p: PidFx, l: PidFxLimits) -> PidFx []
    PidFx { gains: p.gains, limits: l, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: p.saturated }

// The controller with an anti-windup policy given as its
// discriminant.
//
// `pid.PID_WINDUP_*`, shared with the `Float` form so a policy travels
// between them.  An unknown code leaves the policy unchanged; `check`
// reports it.
//
// ```novo
// use pid
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_windup_code(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                    pid.PID_WINDUP_NONE)
//     println("${pidfx.windup_of(p)}")             // 0
// ```
pub fn with_windup_code(p: PidFx, code: Int) -> PidFx []
    // Stored as given, not resolved: `check` has nothing to report
    // about a code this module quietly corrected, and the caller who
    // typed 9 wants to hear about it.  `windup_of` is what answers the
    // policy in force.
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: code, deriv: p.deriv, primed: p.primed, saturated: p.saturated }

// The controller with a derivative source given as its discriminant.
//
// ```novo
// use pid
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_derivative_code(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                        pid.PID_DERIV_ON_ERROR)
//     println("${pidfx.deriv_of(p)}")              // 0
// ```
pub fn with_derivative_code(p: PidFx, code: Int) -> PidFx []
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: code, primed: p.primed, saturated: p.saturated }

// The controller with a first-order low-pass on the derivative.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_derivative_filter(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                          fxq16_16.from_float(0.01))
//     println("${fxq16_16.raw(pidfx.filter_tau(p))}")
// ```
pub fn with_derivative_filter(p: PidFx, tau: FxQ16_16) -> PidFx []
    // The value is stored, not rounded through a float: a caller that
    // passes `from_float(0.01)` and reads the field back gets the same
    // raw word, because the only representation that changed hands is
    // the one it used.
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: tau, kt: p.kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: p.saturated }

// The controller with a back-calculation gain.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_back_calculation(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                                         fxq16_16.one())
//     println("${fxq16_16.raw(pidfx.back_calculation_gain(p))}")   // 65536
// ```
pub fn with_back_calculation(p: PidFx, kt: FxQ16_16) -> PidFx []
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: kt, dt_max: p.dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: p.saturated }

// The controller with a `dt` ceiling, in seconds.
//
// A device with a two-second duty cycle sets four here, which is what
// sensorhub would do.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let p = pidfx.with_max_dt(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256),
//                               fxq16_16.from_int(4))
//     println("${fxq16_16.raw(pidfx.max_dt(p))}")  // 262144
// ```
pub fn with_max_dt(p: PidFx, dt_max: FxQ16_16) -> PidFx []
    PidFx { gains: p.gains, limits: p.limits, setpoint: p.setpoint, integral: p.integral,
            prev_measurement: p.prev_measurement, prev_error: p.prev_error,
            d_state: p.d_state, tau: p.tau, kt: p.kt, dt_max: dt_max,
            output: p.output, p_term: p.p_term, i_term: p.i_term, d_term: p.d_term,
            windup: p.windup, deriv: p.deriv, primed: p.primed,
            saturated: p.saturated }

// ── Reading a controller ─────────────────────────────────────────────

// The output the last step produced.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.output(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)))}")
// ```
pub fn output(p: PidFx) -> FxQ16_16 []
    p.output

// The output as a raw Q16.16 integer.
//
// What a device hands to a PWM register: the duty cycle is already an
// integer and there is no reason to unwrap a type to get it.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.output_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")   // 0
// ```
pub fn output_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.output)

// The proportional term of the last output, raw.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.p_term_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn p_term_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.p_term)

// The integral term of the last output, raw.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.i_term_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn i_term_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.i_term)

// The derivative term of the last output, raw.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.d_term_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn d_term_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.d_term)

// The accumulated integral, raw, before `ki`.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.integral_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn integral_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.integral)

// The error the last step saw, raw.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.error_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn error_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.prev_error)

// The setpoint.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.setpoint(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)))}")
// ```
pub fn setpoint(p: PidFx) -> FxQ16_16 []
    p.setpoint

// The setpoint, raw.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.setpoint_raw(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn setpoint_raw(p: PidFx) -> Int []
    fxq16_16.raw(p.setpoint)

// The gains.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.kp(pidfx.gains_of(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))))}")
// ```
pub fn gains_of(p: PidFx) -> PidFxGains []
    p.gains

// The output limits.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.limit_high(pidfx.limits_of(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))))}")
// ```
pub fn limits_of(p: PidFx) -> PidFxLimits []
    p.limits

// The anti-windup policy's discriminant.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.windup_of(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")   // 1
// ```
pub fn windup_of(p: PidFx) -> Int []
    // The policy IN FORCE, as in the `Float` form: a code that names no
    // policy behaves as clamping, and reporting the field's raw contents
    // here would tell a caller that anti-windup is off when it is on.
    if p.windup == pid.PID_WINDUP_NONE or p.windup == pid.PID_WINDUP_CLAMP
        or p.windup == pid.PID_WINDUP_BACK_CALCULATION
        return p.windup
    pid.PID_WINDUP_CLAMP

// The derivative source's discriminant.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.deriv_of(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")    // 1
// ```
pub fn deriv_of(p: PidFx) -> Int []
    if p.deriv == pid.PID_DERIV_ON_ERROR or p.deriv == pid.PID_DERIV_ON_MEASUREMENT
        return p.deriv
    pid.PID_DERIV_ON_MEASUREMENT

// The derivative filter's time constant.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.filter_tau(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)))}")
// ```
pub fn filter_tau(p: PidFx) -> FxQ16_16 []
    p.tau

// The back-calculation gain.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.back_calculation_gain(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)))}")
// ```
pub fn back_calculation_gain(p: PidFx) -> FxQ16_16 []
    p.kt

// The `dt` ceiling.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.max_dt(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256)))}")
// ```
pub fn max_dt(p: PidFx) -> FxQ16_16 []
    p.dt_max

// Whether the last output hit a limit.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.is_saturated(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")
// ```
pub fn is_saturated(p: PidFx) -> Bool []
    p.saturated

// Whether the controller holds a previous sample.
//
// ```novo
// use pidfx
//
// fn main() [io]
//     println("${pidfx.is_primed(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))}")   // false
// ```
pub fn is_primed(p: PidFx) -> Bool []
    p.primed

// ── Checking ─────────────────────────────────────────────────────────

// Whether `x` is sitting on either end of the container, which is how a
// value that did not fit arrives in this form: `from_float(40000.0)`
// answers `max_value()` and raises nothing.  `FxQ16_16` has no NaN and
// no infinity, so this is the whole of this form's answer to the
// `Float` form's `finite`.
fn at_limit(x: FxQ16_16) -> Bool
    if fxq16_16.compare(x, fxq16_16.max_value()) == 0
        return true
    fxq16_16.compare(x, fxq16_16.min_value()) == 0

// `None` if the controller's configuration is usable, the refusal if
// it is not.
//
// The same checks `pid.check` makes, plus the one this form has of its
// own: a gain, a limit or a setpoint that SATURATED on the way in.
// `fxq16_16.from_float(40000.0)` is `32767.99998` and no error, which
// is the right behaviour for a `@value` constructor and the wrong
// thing to discover from a control loop's behaviour — so it is
// reported here, where a person is looking.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     let bad = pidfx.controller(
//                   pidfx.gains(fxq16_16.from_int(2), fxq16_16.zero(), fxq16_16.zero()),
//                   pidfx.limits(fxq16_16.from_int(100), fxq16_16.zero()),
//                   fxq16_16.from_int(21))
//     match pidfx.check(bad)
//         Some(_) => println("the limits are the wrong way round")
//         None    => println("usable")
// ```
pub @tier(app)
fn check(p: PidFx) -> ?PidError []
    // A field that saturated first.  `pid.check`'s `finite` guards
    // exist because a NaN compares false against everything and every
    // test below would report the wrong field; the same is true here of
    // a value wearing the container's end, so the same order applies.
    // "Not finite" is this form's word for "not representable".
    if at_limit(p.limits.lo)
        return Some(PidNotFinite("limit_low"))
    if at_limit(p.limits.hi)
        return Some(PidNotFinite("limit_high"))
    if at_limit(p.setpoint)
        return Some(PidNotFinite("setpoint"))
    if at_limit(p.gains.kp)
        return Some(PidNotFinite("kp"))
    if at_limit(p.gains.ki)
        return Some(PidNotFinite("ki"))
    if at_limit(p.gains.kd)
        return Some(PidNotFinite("kd"))
    if at_limit(p.tau)
        return Some(PidNotFinite("tau"))
    if at_limit(p.kt)
        return Some(PidNotFinite("kt"))
    if at_limit(p.dt_max)
        return Some(PidNotFinite("dt_max"))
    if fxq16_16.compare(p.limits.lo, p.limits.hi) >= 0
        return Some(PidLimitsNotOrdered(fxq16_16.to_float(p.limits.lo),
                                        fxq16_16.to_float(p.limits.hi)))
    if fxq16_16.compare(p.gains.kp, fxq16_16.zero()) < 0
        return Some(PidGainNegative("kp", fxq16_16.to_float(p.gains.kp)))
    if fxq16_16.compare(p.gains.ki, fxq16_16.zero()) < 0
        return Some(PidGainNegative("ki", fxq16_16.to_float(p.gains.ki)))
    if fxq16_16.compare(p.gains.kd, fxq16_16.zero()) < 0
        return Some(PidGainNegative("kd", fxq16_16.to_float(p.gains.kd)))
    if fxq16_16.compare(p.tau, fxq16_16.zero()) < 0
        return Some(PidFilterNegative(fxq16_16.to_float(p.tau)))
    if fxq16_16.compare(p.kt, fxq16_16.zero()) < 0
        return Some(PidBackCalculationGainInvalid(fxq16_16.to_float(p.kt)))
    if p.windup == pid.PID_WINDUP_BACK_CALCULATION
        and fxq16_16.compare(p.kt, fxq16_16.zero()) == 0
        return Some(PidBackCalculationGainInvalid(fxq16_16.to_float(p.kt)))
    if fxq16_16.compare(p.dt_max, fxq16_16.zero()) <= 0
        return Some(PidMaxDtInvalid(fxq16_16.to_float(p.dt_max)))
    // The stored code, not `windup_of`'s answer: this is the one place
    // a code nobody meant is reported rather than papered over.
    if p.windup != pid.PID_WINDUP_NONE and p.windup != pid.PID_WINDUP_CLAMP
        and p.windup != pid.PID_WINDUP_BACK_CALCULATION
        return Some(PidUnknownPolicyCode("windup", p.windup))
    if p.deriv != pid.PID_DERIV_ON_ERROR and p.deriv != pid.PID_DERIV_ON_MEASUREMENT
        return Some(PidUnknownPolicyCode("deriv", p.deriv))
    None
