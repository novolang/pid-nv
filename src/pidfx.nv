// The output limits.
//
// ```novo
// use fxq16_16
// use pidfx
//
// fn main() [io]
//     println("${fxq16_16.raw(pidfx.limit_high(pidfx.limits_of(pidfx.controller_raw(131072, 0, 0, 0, 6553600, 1376256))))}")
// ```
pub fn limits_of(p: PidFx) -> PidFxLimits []
    todo("pid-nv.pidfx.limits_of")

// The anti-windup policy's discriminant.
//
// ```novo
// use pidfx
